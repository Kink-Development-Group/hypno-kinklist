{
  "name": "hypno-kinklist",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\" \"*.{ts,js,json,md,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\" \"*.{ts,js,json,md,html}\" \".github/**/*.yml\"",
    "check": "bun run format:check && bun run lint && bun run test --run && bun run build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "^4.2.1",
    "monaco-editor": "^0.55.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5",
    "@vitest/ui": "^5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
